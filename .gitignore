# Whitelist: only project source, build descriptions, documentation, and scripts.
*
!/.gitignore
!/AGENTS.md
!/README.md
!/MODLOG.md
!/STATUS.md
!/templates/
!/templates/*.md
!/rust-toolchain.toml
!/docs/
!/docs/*.md
!/passthrough/
!/passthrough/Cargo.toml
!/passthrough/Cargo.lock
!/passthrough/src/
!/passthrough/src/**/
!/passthrough/src/**/*.rs
!/passthrough/tests/
!/passthrough/tests/**/*.rs
!/tools/
!/tools/*.ps1
!/minecraft/
!/minecraft/build.gradle
!/minecraft/settings.gradle
!/minecraft/gradle.properties
!/minecraft/src/
!/minecraft/src/**/
!/minecraft/src/**/*.java
!/minecraft/src/**/*.json
!/minecraft/diagnostics/
!/minecraft/diagnostics/*.java
